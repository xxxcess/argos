# Branch-owned runtime identity for the native macOS launcher.
# start-macos.sh reads this file after local .env values are loaded.
# Keep this file product-line specific; do not select it from the current Git ref.

ARGOS_RUNTIME_ID=argos-venture
ARGOS_PRODUCT_NAME="Argos Venture"
ARGOS_STORAGE_SLUG=argos-venture
ARGOS_DEFAULT_PORT=7861
ARGOS_DEFAULT_CHROMADB_PORT=8101
ARGOS_DEFAULT_APFEL_PORT=11436
BIBLE_API_MIN_REQUEST_INTERVAL_SECONDS=1.5
BIBLE_API_ALLOW_FULL_TESTAMENT_IMPORT=false
